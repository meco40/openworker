# Local development defaults (Mem0 runs on localhost:8010 via docker-compose.mem0-local.yml)
MEMORY_PROVIDER=mem0
MEM0_BASE_URL=http://127.0.0.1:8010
MEM0_API_KEY=local-mem0-dev-token
# The bundled mem0-local image exposes its REST endpoints at the root path.
MEM0_API_PATH=/
MEM0_TIMEOUT_MS=60000
MEM0_READ_TIMEOUT_MS=5000
MEM0_WRITE_TIMEOUT_MS=15000
# Per-fact store timeout in knowledge ingestion; mem0 runs LLM extraction + embeddings per add (20-40s cold).
MEM0_STORE_FACT_TIMEOUT_MS=60000
MEM0_MAX_RETRIES=3
MEM0_WRITE_MAX_RETRIES=1
MEM0_RETRY_BASE_DELAY_MS=500
MEM0_EMBEDDER_SYNC_TIMEOUT_MS=10000

# Keep Mem0-heavy knowledge ingestion out of the web request path by default.
# The scheduler remains the default ingestion runtime; only opt in here for
# targeted debugging or controlled experiments.
KNOWLEDGE_INLINE_INGESTION_ENABLED=false
KNOWLEDGE_PRE_INGEST_ON_RECALL=false

# Keep auto-session memory writes out of the web request path by default.
# Only opt in while explicitly debugging this feature.
CHAT_AUTO_SESSION_MEMORY=off
AUTO_SESSION_MEMORY_LOGS=false
AUTO_SESSION_MEMORY_SLOW_MS=1000

# Embeddings used by Mem0 are auto-synced from Model Hub profile `p1-embeddings`
# via POST /configure/embedder on the mem0-local service.
# LLM used by Mem0 is auto-synced from Model Hub profile `p1`
# via POST /configure/llm on the mem0-local service.
# The World-Model embedding worker uses the same active `p1-embeddings`
# profile when no explicit EMBEDDING_API_URL/OPENAI_* override is configured.
# Set EMBEDDING_MODEL_VERSION when the provider changes weights without a
# pipeline-model replacement and a full re-embedding must be forced.
# EMBEDDING_MODEL_VERSION=1
#
# Optional bootstrap values (only needed if you want mem0-local preconfigured
# before the first Model Hub sync):
# MEM0_LLM_PROVIDER=
# MEM0_LLM_MODEL=
# MEM0_LLM_API_KEY=
# MEM0_LLM_BASE_URL=
# MEM0_EMBEDDER_PROVIDER=
# MEM0_EMBEDDER_MODEL=
# MEM0_EMBEDDER_API_KEY=
# MEM0_EMBEDDER_BASE_URL=
# MEM0_EMBEDDING_DIMS=768

# Optional but recommended for Model Hub crypto
MODEL_HUB_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Webhook and external-skill safety defaults
# Set WEBHOOK_SECRET in every deployed environment. The insecure fallback is
# intended only for local tests/development and is rejected in production.
# WEBHOOK_SECRET=
ALLOW_INSECURE_WEBHOOKS=false
ALLOW_OPEN_WHATSAPP_INBOUND=false
WHATSAPP_WEBHOOK_FETCH_MEDIA=false
WHATSAPP_WEBHOOK_MEDIA_ALLOWED_HOSTS=
EXTERNAL_SKILLS_ENABLED=false

# Agent Room rollout flags
NEXT_PUBLIC_AGENT_ROOM_ENABLED=true
AGENT_ROOM_ENABLED=true
AGENT_V2_MAX_REQUESTS_PER_MINUTE=600

# Inbox v2 rollout and safety controls
INBOX_V2_ENABLED=true
INBOX_V2_EVENTS_ENABLED=true
INBOX_V2_LOGS=false
CHAT_DISPLAY_LOGS=false
CHAT_DISPLAY_SLOW_MS=1000
INBOX_DB_SLOW_MS=500
INBOX_HTTP_RATE_LIMIT_PER_MINUTE=120
INBOX_WS_RATE_LIMIT_PER_MINUTE=240

# World Model (canonical system of record, Phase 1). Off by default (fail-closed).
# Start the canonical PostgreSQL (pgvector) service via:
#   docker compose -f docker-compose.postgres.yml up -d
WORLD_MODEL_ENABLED=false
CANONICAL_DATABASE_URL=postgresql://clawtest:clawtest@127.0.0.1:5434/clawtest
# Dedicated runtime URLs are provisioned by scripts/world-model-provision-roles.ts.
# Keep the admin URL out of the application process and never commit role passwords.
# WORLD_MODEL_ADMIN_DATABASE_URL=postgresql://<migration-admin>:<password>@127.0.0.1:5434/clawtest
# WORLD_MODEL_APP_ROLE_PASSWORD=<set-only-for-provision-command>
# WORLD_MODEL_WORKER_ROLE_PASSWORD=<set-only-for-provision-command>
# WORLD_MODEL_APP_DATABASE_URL=postgresql://world_model_app:<password>@127.0.0.1:5434/clawtest
# WORLD_MODEL_WORKER_DATABASE_URL=postgresql://world_model_worker:<password>@127.0.0.1:5434/clawtest
WORLD_MODEL_POOL_MAX=10
WORLD_MODEL_OUTBOX_POLL_INTERVAL_MS=10000
WORLD_MODEL_OUTBOX_BATCH_SIZE=100
# Optional comma-separated user:persona:workspace scopes for worker-only data
# that is not represented in the legacy conversation store.
WORLD_MODEL_DISPATCH_SCOPES=
WORLD_MODEL_INGESTION_BRIDGE=false
# Set to true only in integration tests that need live PostgreSQL.
WORLD_MODEL_E2E=false
GRAPHITI_SHADOW_ENABLED=false
WORLD_MODEL_MEM0_PREFERENCES_ONLY=false
# Rollout-Modus: off | shadow | required | canonical (Default: off). Der Modus
# ersetzt die Einzelschalter; zwischenzeitlich bleiben die Legacy-Booleans
# kompatibel.
WORLD_MODEL_MODE=off
# Optional comma-separated user:persona:workspace scope allowlist for a
# canonical canary. Empty means no scope restriction.
WORLD_MODEL_CANARY_SCOPES=
# Intervall (ms) fuer den Prospective Runtime Takt im Scheduler (Open-Loop-
# Zustellung + Heartbeat-Reconciliation). Default: 60000.
WORLD_MODEL_PROSPECTIVE_INTERVAL_MS=60000
# Nutzerinteraktion gilt waehrend dieses Fensters (ms) als aktiv und blockt
# proaktive Zustellungen. Default: 5 Minuten.
WORLD_MODEL_USER_ACTIVE_WINDOW_MS=300000

# Optional official Graphiti REST projection (Neo4j backend).
# Graphiti requires its own LLM credential; keep it separate from the app's
# encrypted Model Hub accounts and set it only when the compose stack is used.
# GRAPHITI_BASE_URL=http://127.0.0.1:8001
# GRAPHITI_PROJECTOR_ENABLED=false
# GRAPHITI_OPENAI_API_KEY=
# GRAPHITI_NEO4J_USER=neo4j
# GRAPHITI_NEO4J_PASSWORD=change-me-local
# GRAPHITI_TIMEOUT_MS=10000
# GRAPHITI_MAX_RETRIES=3
# GRAPHITI_MAX_MESSAGE_CHARS=1200
