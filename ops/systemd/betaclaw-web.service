[Unit]
Description=BetaClaw Web Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/betaclaw
Environment=NODE_ENV=production
Environment=HOSTNAME=0.0.0.0
Environment=PORT=3000
ExecStart=/usr/bin/env node --import tsx /opt/betaclaw/server.ts
Restart=always
RestartSec=5
User=betaclaw
Group=betaclaw

[Install]
WantedBy=multi-user.target
