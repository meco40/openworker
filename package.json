{
  "name": "betaclaw-gateway-control-plane",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-stack-rust.mjs",
    "dev:static": "node scripts/dev-stack-rust.mjs --static",
    "dev:import-legacy": "node scripts/dev-import-legacy.mjs",
    "dev:node": "node scripts/dev-stack.mjs",
    "dev:gateway": "cross-env NODE_ENV=production betaclaw-gateway",
    "dev:web": "cross-env NODE_ENV=development tsx watch server.ts",
    "dev:web-ui": "cross-env NODE_ENV=development PORT=3001 BETACLAW_DISABLE_WS=true TRUST_PROXY_LOOPBACK_MARKER=true tsx watch server.ts",
    "dev:scheduler": "tsx watch scheduler.ts",
    "dev:next": "next dev --turbopack -H 127.0.0.1",
    "rust:build": "docker build -f docker/Dockerfile.gateway -t betaclaw-gateway-local .",
    "rust:test": "docker run --rm -v ./rust:/app -v betaclaw-cargo-registry:/usr/local/cargo/registry -v betaclaw-rust-target:/app/target -v betaclaw-rustup:/usr/local/rustup -w /app rust:1.94-bookworm cargo test --features test-support",
    "rust:clippy": "docker run --rm -v ./rust:/app -v betaclaw-cargo-registry:/usr/local/cargo/registry -v betaclaw-rust-target:/app/target -v betaclaw-rustup:/usr/local/rustup -w /app rust:1.94-bookworm cargo clippy --all-targets -- -D warnings",
    "rust:fmt": "docker run --rm -v ./rust:/app -v betaclaw-cargo-registry:/usr/local/cargo/registry -v betaclaw-rust-target:/app/target -v betaclaw-rustup:/usr/local/rustup -w /app rust:1.94-bookworm cargo fmt --all",
    "rust:fmt:check": "docker run --rm -v ./rust:/app -v betaclaw-cargo-registry:/usr/local/cargo/registry -v betaclaw-rust-target:/app/target -v betaclaw-rustup:/usr/local/rustup -w /app rust:1.94-bookworm cargo fmt --all -- --check",
    "fixtures:security-rules": "node scripts/ci/export-security-rules.mjs",
    "fixtures:nextauth-token": "node scripts/fixtures/generate-nextauth-token.mjs",
    "fixtures:gemini-traffic": "node --import tsx scripts/fixtures/record-gemini-traffic.mjs",
    "verify:logs-parity": "node --import tsx scripts/verify/logs-parity.mjs",
    "verify:route-parity": "node --import tsx scripts/verify/parity/run.mjs",
    "verify:route-coverage": "node scripts/verify/route-coverage.mjs",
    "cli": "node --import tsx src/cli/program.ts",
    "cli:gateway": "node --import tsx src/cli/program.ts gateway",
    "cli:channels": "node --import tsx src/cli/program.ts channels",
    "cli:node": "node --import tsx src/cli/program.ts node",
    "lint": "oxlint . --threads=1",
    "lint:fix": "oxlint . --fix --threads=1",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:architecture:guards": "vitest run tests/unit/architecture/agent-legibility-guards.test.ts tests/unit/architecture/ast-legibility-guards.test.ts",
    "test:components": "vitest run --project=components",
    "test:components:watch": "vitest --project=components",
    "test:e2e": "npm run test:e2e:smoke",
    "test:e2e:production": "node scripts/e2e/run-production-smoke.mjs",
    "test:e2e:smoke": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:live": "node --import tsx scripts/e2e/live-preflight.ts && vitest run --config vitest.e2e.live.config.ts",
    "test:e2e:browser": "playwright test",
    "test:e2e:browser:ci": "playwright test tests/e2e/browser/authentication.spec.ts tests/e2e/browser/chat-smoke.spec.ts tests/e2e/browser/chat-queue-and-persona.spec.ts tests/e2e/browser/mission-control-run-feedback.spec.ts tests/e2e/browser/integration-scenarios.spec.ts tests/e2e/browser/keyboard-navigation.spec.ts",
    "harness:verify": "node scripts/harness/agent-verify.mjs",
    "ci:flaky-detect": "node --import tsx scripts/ci/flaky-detection.ts",
    "ci:cleanup:analyze": "node scripts/ci/cleanup-low-risk.mjs analyze",
    "ci:cleanup:apply": "node scripts/ci/cleanup-low-risk.mjs apply",
    "build": "next build --turbopack",
    "build:export": "cross-env NEXT_EXPORT=true next build --turbopack",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "knip": "knip",
    "start:web": "cross-env NODE_ENV=production node --import tsx server.ts",
    "start:scheduler": "cross-env NODE_ENV=production node --import tsx scheduler.ts",
    "start": "npm run start:web",
    "memory:reset": "node --import tsx scripts/memory-reset.ts",
    "memory:cleanup-noise": "node --import tsx scripts/memory-cleanup-noise.ts",
    "memory:backfill-channel-scope": "node --import tsx scripts/memory-backfill-channel-scope.ts",
    "memory:migrate-to-postgres": "node --import tsx scripts/memory-migrate-to-postgres.ts",
    "local:cleanup": "node --import tsx scripts/cleanup-local-artifacts.ts --apply",
    "local:cleanup:dry": "node --import tsx scripts/cleanup-local-artifacts.ts --dry-run",
    "test:artifacts:clean": "node --import tsx scripts/cleanup-test-artifacts.ts --apply",
    "test:artifacts:clean:dry": "node --import tsx scripts/cleanup-test-artifacts.ts --dry-run",
    "workspaces:cleanup": "node --import tsx scripts/cleanup-task-workspaces.ts",
    "workspaces:cleanup:json": "node --import tsx scripts/cleanup-task-workspaces.ts --json",
    "knowledge:ingest": "node --import tsx scripts/trigger-knowledge-ingestion.ts",
    "attachments:consistency": "node --import tsx scripts/attachments-consistency.ts",
    "smoke:chat-cli-approval": "node --import tsx scripts/smoke-chat-cli-approval.ts",
    "world-model:migrate": "node --import tsx scripts/world-model-migrate.ts",
    "world-model:backfill": "node --import tsx scripts/world-model-backfill.ts",
    "world-model:reconcile": "node --import tsx scripts/world-model-reconcile.ts",
    "world-model:rebuild-projections": "node --import tsx scripts/world-model-rebuild-projections.ts",
    "world-model:graphiti-evaluate": "node --import tsx scripts/world-model-graphiti-evaluate.ts",
    "world-model:provision-roles": "node --import tsx scripts/world-model-provision-roles.ts",
    "world-model:verify-rls": "node --import tsx scripts/world-model-verify-rls.ts",
    "world-model:runtime-evidence": "node --import tsx scripts/world-model-runtime-evidence.ts",
    "world-model:drill": "node --import tsx scripts/world-model-failure-drill.ts",
    "world-model:lifecycle": "node --import tsx scripts/world-model-lifecycle.ts",
    "world-model:rollout-gate": "node --import tsx scripts/world-model-rollout-gate.ts",
    "world-model:rekey-chat-sources": "node --import tsx scripts/world-model-rekey-chat-sources.ts",
    "world-model:benchmark-embeddings": "node --import tsx scripts/world-model-benchmark-embeddings.ts",
    "mem0:audit": "node --import tsx scripts/mem0-factual-memory-audit.ts",
    "avatar:sync-headaudio": "node scripts/avatar/sync-headaudio-assets.mjs",
    "avatar:validate": "node scripts/avatar/validate-master-avatar.mjs",
    "mem0:local:up": "docker compose --env-file .env.local -f docker-compose.mem0-local.yml up -d --build",
    "mem0:local:down": "docker compose --env-file .env.local -f docker-compose.mem0-local.yml down",
    "mem0:local:logs": "docker compose --env-file .env.local -f docker-compose.mem0-local.yml logs -f mem0-local mem0-postgres",
    "mem0:local:ps": "docker compose --env-file .env.local -f docker-compose.mem0-local.yml ps",
    "graphiti:local:up": "docker compose --env-file .env.local -f docker-compose.graphiti.yml up -d",
    "graphiti:local:down": "docker compose --env-file .env.local -f docker-compose.graphiti.yml down",
    "graphiti:local:logs": "docker compose --env-file .env.local -f docker-compose.graphiti.yml logs -f graphiti graphiti-neo4j",
    "graphiti:local:ps": "docker compose --env-file .env.local -f docker-compose.graphiti.yml ps",
    "dev:stack": "npm run dev",
    "speckit:help": "pwsh -File .specify/scripts/powershell/check-prerequisites.ps1 -Help",
    "speckit:new": "pwsh -File .specify/scripts/powershell/create-new-feature.ps1",
    "speckit:plan:init": "pwsh -File .specify/scripts/powershell/setup-plan.ps1 -Json",
    "speckit:agent:update": "pwsh -File .specify/scripts/powershell/update-agent-context.ps1 -AgentType codex",
    "postinstall": "npm run avatar:sync-headaudio",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@met4citizen/headaudio": "1.0.0",
    "@met4citizen/talkinghead": "1.8.2",
    "@next/env": "^16.4.3",
    "@types/three": "^0.186.0",
    "@xyflow/react": "^12.12.0",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.10.2",
    "css-tree": "^3.2.1",
    "mermaid": "^12.2.0",
    "next": "^16.4.3",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "^6.44.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "typescript-api": "npm:typescript@^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix --threads=1",
      "prettier --write"
    ],
    "*.{json,md,css,scss,yml,yaml}": "prettier --write"
  },
  "knip": {
    "ignore": [
      "backups/**",
      "workspaces/**",
      ".worktrees/**",
      "demo/**",
      ".tmp/**",
      ".local/**",
      ".next/**",
      "dist/**",
      ".specify/**",
      ".codex/**"
    ]
  },
  "pnpm": {
    "overrides": {
      "glob": "^14.0.2",
      "minimatch": "^11.0.1",
      "rimraf": "^6.1.3",
      "protobufjs": "^7.6.5",
      "undici": "^7.29.1",
      "katex": "0.18.2",
      "smol-toml": "^1.9.0",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
      "dompurify@>=3.4.13 <=3.4.15": "^3.4.16",
      "fflate@>=0.8.0 <0.8.3": "^0.8.3",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "@google/genai",
      "better-sqlite3"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "nodemailer": "^10.0.16"
      }
    }
  },
  "packageManager": "pnpm@10.30.1+sha512.3590e550d5384caa39bd5c7c739f72270234b2f6059e13018f975c313b1eb9fefcc09714048765d4d9efe961382c312e624572c0420762bdc5d5940cdf9be73a"
}
